# =============================================================================
# AhiaUlo — environment variables
# Copy to .env.local for local dev. Set the same keys in your host (e.g. Vercel).
# Never commit .env.local or real secret values to git.
# =============================================================================

# --- Required (Supabase) ---
# Project URL from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key (safe for browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Required (server-only) ---
# Service role key — NEVER prefix with NEXT_PUBLIC_
# Used only in server actions (admin delete user, delete own profile)
SUPABASE_SERVICE_ROLE_KEY=

# Admin owner email for console access
ADMIN_EMAIL=ezehsomtoo95@gmail.com

# --- Server-side notify (Next.js → Edge Function) ---
# Same secret as Edge Function / app_config.admin_notify_secret
# Sent as header: x-admin-notify-secret
ADMIN_NOTIFY_SECRET=

# --- Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets) ---
# RESEND_API_KEY=              # Required — Resend API key for all transactional emails
# ADMIN_NOTIFY_SECRET=         # Must match Next.js + app_config.admin_notify_secret
# ADMIN_EMAIL=                 # Optional — defaults to ezehsomtoo95@gmail.com
# FROM_EMAIL=                  # Optional — defaults to info@ahiaulo.ng
#
# After deploying admin-notify, set in SQL editor:
#   INSERT INTO public.app_config (key, value) VALUES
#     ('admin_notify_function_url', 'https://<project-ref>.supabase.co/functions/v1/admin-notify'),
#     ('admin_notify_secret', '<ADMIN_NOTIFY_SECRET>')
#   ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value;
#
# Triggers (migration 0039):
#   auth.users INSERT  → admin email (type: new_signup)
#   messages INSERT    → seller email when buyer messages (type: new_message)

# Support WhatsApp number, E.164 digits without + (defaults to placeholder if unset)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
