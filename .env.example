# =============================================================================
# AhiaUlo — environment variables
# Copy to .env.local for local dev. Set the same keys in your host (e.g. Vercel).
# Never commit .env.local or real secret values to git.
# =============================================================================

# --- Required (Supabase) ---
# Project URL from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key (safe for browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Required (server-only) ---
# Service role key — NEVER prefix with NEXT_PUBLIC_
# Used only in server actions (admin delete user, delete own profile)
SUPABASE_SERVICE_ROLE_KEY=

# Admin owner email for console access
ADMIN_EMAIL=ezehsomtoo95@gmail.com

# --- Server-side notify (Next.js → Edge Function) ---
# Same secret as Edge Function / app_config.admin_notify_secret
# Sent as header: x-admin-notify-secret
ADMIN_NOTIFY_SECRET=

# --- Supabase Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets) ---
# RESEND_API_KEY=            # Resend API key (already configured)
# ADMIN_NOTIFY_SECRET=       # Must match Next.js ADMIN_NOTIFY_SECRET and app_config.admin_notify_secret
# SUPABASE_SERVICE_ROLE_KEY= # Auto-injected in Edge Functions; optional alternate auth header
# Support WhatsApp number, E.164 digits without + (defaults to placeholder if unset)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
